// 03 — Orphan Cluster Detection
// Question: Find clusters of orphaned (no real owner) sensitive assets that
// share BOTH the same data source AND the same last-accessor.
// These are silent risk piles — typically a former employee + an unmaintained share.

let src = BigIDDSPMAssetStoreDemo_CL
| extend OwnerUpn = tostring(parse_json(AssetOwner).AccountUpn)
| where OwnerUpn == "unknown" or isempty(OwnerUpn)
| where Classification has_any ("PII","PHI","PCI","Financial","HIPAA","Trade Secret","Restricted","GDPR")
| project AssetID, AssetName, AssetSource, Classification, UserName;
let assetNodes = src
| project nodeId = tostring(AssetID), nodeType = "Asset",
          label = AssetName, classification = tostring(Classification),
          dataSource = tostring(AssetSource);
let dsNodes = src | distinct AssetSource
| project nodeId = strcat("ds::", AssetSource), nodeType = "DataSource",
          label = tostring(AssetSource), classification = "", dataSource = tostring(AssetSource);
let userNodes = src | where isnotempty(UserName) and UserName contains "@" | distinct UserName
| project nodeId = tostring(UserName), nodeType = "User",
          label = tostring(UserName), classification = "", dataSource = "";
let nodes = union assetNodes, dsNodes, userNodes
| distinct nodeId, nodeType, label, classification, dataSource;
let edges = union
    (src | project source = tostring(AssetID), target = strcat("ds::", AssetSource), edge = "STORED_IN"),
    (src | where isnotempty(UserName) and UserName contains "@"
         | project source = tostring(AssetID), target = tostring(UserName), edge = "LAST_ACCESSED_BY");
edges
| make-graph source --> target with nodes on nodeId
| graph-match (asset)-[e1]->(ds)
    where asset.nodeType == "Asset" and ds.nodeType == "DataSource"
    project asset_id = asset.label,
            data_source = ds.label,
            classification = asset.classification
| summarize orphan_count = dcount(asset_id),
            classifications = make_set(classification, 5),
            sample_assets = make_set(asset_id, 5)
        by data_source
| where orphan_count >= 2
| order by orphan_count desc
| take 25
