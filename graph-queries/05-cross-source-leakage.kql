// 05 — Cross-Source Leakage (Data Sprawl)
// Question: For each owner + classification, how many distinct data sources
// hold sensitive assets they own? 3+ data sources = textbook DLP-failure pattern.

let src = BigIDDSPMAssetStoreDemo_CL
| extend OwnerUpn = tostring(parse_json(AssetOwner).AccountUpn)
| where isnotempty(OwnerUpn) and OwnerUpn != "unknown"
| where Classification has_any ("PII","PHI","PCI","Financial","HIPAA","Trade Secret","Restricted","GDPR")
| project AssetID, AssetName, Classification, AssetSource, OwnerUpn;
let assetNodes = src
| project nodeId = tostring(AssetID), nodeType = "Asset",
          label = AssetName, classification = tostring(Classification),
          dataSource = tostring(AssetSource);
let dsNodes = src | distinct AssetSource
| project nodeId = strcat("ds::", AssetSource), nodeType = "DataSource",
          label = tostring(AssetSource), classification = "", dataSource = tostring(AssetSource);
let ownerNodes = src | distinct OwnerUpn
| project nodeId = OwnerUpn, nodeType = "User",
          label = OwnerUpn, classification = "", dataSource = "";
let nodes = union assetNodes, dsNodes, ownerNodes
| distinct nodeId, nodeType, label, classification, dataSource;
let edges = union
    (src | project source = OwnerUpn, target = tostring(AssetID), edge = "OWNS"),
    (src | project source = tostring(AssetID), target = strcat("ds::", AssetSource), edge = "STORED_IN");
edges
| make-graph source --> target with nodes on nodeId
| graph-match (owner)-[e1]->(asset)-[e2]->(ds)
    where owner.nodeType == "User"
      and asset.nodeType == "Asset"
      and ds.nodeType == "DataSource"
      and asset.classification has_any ("PII","PHI","PCI","Financial","HIPAA","Trade Secret","Restricted","GDPR")
    project owner_id = owner.label,
            classification = asset.classification,
            data_source = ds.label,
            asset_label = asset.label
| summarize distinct_data_sources = dcount(data_source),
            asset_count = dcount(asset_label),
            sources = make_set(data_source, 10),
            sample_assets = make_set(asset_label, 5)
        by owner_id, classification
| where distinct_data_sources >= 3
| order by distinct_data_sources desc, asset_count desc
| take 25
