// 04 — Threat Lateral Movement on Regulated Data
// Question: Trace every path from a malicious source IP, through a threat hit,
// onto regulated assets, in <= 2 hops.

let src = BigIDDSPMAssetStoreDemo_CL
| extend OwnerUpn = tostring(parse_json(AssetOwner).AccountUpn)
| project AssetID, AssetName, AssetSource, Classification, OwnerUpn,
          ThreatCategory, RequestSourceIP;
let threatRows = src | where isnotempty(ThreatCategory) and isnotempty(RequestSourceIP);
let assetNodes = src
| project nodeId = tostring(AssetID), nodeType = "Asset",
          label = AssetName, classification = tostring(Classification),
          dataSource = tostring(AssetSource);
let ipNodes = threatRows | distinct RequestSourceIP
| project nodeId = strcat("ip::", RequestSourceIP), nodeType = "SourceIP",
          label = tostring(RequestSourceIP), classification = "", dataSource = "";
let threatNodes = threatRows
| extend tnode = strcat("th::", AssetID, "::", ThreatCategory)
| project nodeId = tnode, nodeType = "Threat",
          label = tostring(ThreatCategory), classification = "", dataSource = "";
let nodes = union assetNodes, ipNodes, threatNodes
| distinct nodeId, nodeType, label, classification, dataSource;
let edges = union
    (threatRows | extend tnode = strcat("th::", AssetID, "::", ThreatCategory)
                | project source = strcat("ip::", RequestSourceIP), target = tnode, edge = "ATTACKED"),
    (threatRows | extend tnode = strcat("th::", AssetID, "::", ThreatCategory)
                | project source = tnode, target = tostring(AssetID), edge = "TARGETED");
edges
| make-graph source --> target with nodes on nodeId
| graph-match (ip)-[e1]->(threat)-[e2]->(asset)
    where ip.nodeType == "SourceIP"
      and threat.nodeType == "Threat"
      and asset.nodeType == "Asset"
      and asset.classification has_any ("PII","PHI","PCI","Financial","GDPR","HIPAA","Trade Secret","Restricted")
    project source_ip = ip.label,
            threat_category = threat.label,
            regulated_asset = asset.label,
            classification = asset.classification,
            data_source = asset.dataSource
| summarize hits = count(),
            sample_assets = make_set(regulated_asset, 5),
            classifications = make_set(classification, 5),
            data_sources = make_set(data_source, 5)
        by source_ip, threat_category
| order by hits desc
| take 25
