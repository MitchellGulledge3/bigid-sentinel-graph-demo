// 01 — Sensitive Data Blast Radius
// Question: For each identity (User or ExternalParty), how many sensitive
// assets are reachable via OWNED_BY / SHARED_WITH / LAST_ACCESSED_BY edges?
// Output: identity, blast_score, reachable assets, classifications, sources.

let src = BigIDDSPMAssetStoreDemo_CL
| extend OwnerUpn = tostring(parse_json(AssetOwner).AccountUpn)
| extend Perms = parse_json(AssetPermissions)
| extend AllUsers = array_concat(
    coalesce(Perms.Read, dynamic([])),
    coalesce(Perms.Write, dynamic([])),
    coalesce(Perms.FullControl, dynamic([])))
| project AssetID, AssetName, AssetSource, Classification, OwnerUpn, UserName, AllUsers;
let assetNodes = src
| project nodeId = tostring(AssetID), nodeType = "Asset",
          label = AssetName, classification = tostring(Classification),
          dataSource = tostring(AssetSource);
let identityNodes = src
| mv-expand u = AllUsers to typeof(string)
| extend ids = pack_array(OwnerUpn, UserName, u)
| mv-expand id = ids to typeof(string)
| where isnotempty(id) and id contains "@" and id != "unknown"
| extend isExternal = id !contains "@contoso.com"
| project nodeId = id, nodeType = iff(isExternal, "ExternalParty", "User"),
          label = id, classification = "", dataSource = ""
| distinct nodeId, nodeType, label, classification, dataSource;
let nodes = union assetNodes, identityNodes
| distinct nodeId, nodeType, label, classification, dataSource;
let edges = union
    (src | where isnotempty(OwnerUpn) and OwnerUpn != "unknown"
         | project source = tostring(AssetID), target = OwnerUpn, edge = "OWNED_BY"),
    (src | mv-expand u = AllUsers to typeof(string)
         | where isnotempty(u) and u contains "@"
         | project source = tostring(AssetID), target = tostring(u), edge = "SHARED_WITH"),
    (src | where isnotempty(UserName) and UserName contains "@"
         | project source = tostring(AssetID), target = tostring(UserName), edge = "LAST_ACCESSED_BY");
edges
| make-graph source --> target with nodes on nodeId
| graph-match (asset)-[e]->(identity)
    where asset.nodeType == "Asset"
      and (identity.nodeType == "User" or identity.nodeType == "ExternalParty")
      and asset.classification has_any ("PII","PHI","PCI","Financial","HIPAA","Trade Secret","Restricted","GDPR")
    project identity_id = identity.label,
            identity_type = identity.nodeType,
            reachable_asset = asset.label,
            classification = asset.classification,
            data_source = asset.dataSource
| summarize reachable_asset_count = dcount(reachable_asset),
            sample_assets = make_set(reachable_asset, 5),
            classifications = make_set(classification, 8),
            data_sources = make_set(data_source, 5)
        by identity_id, identity_type
| extend cls_str = tostring(classifications)
| extend blast_score = reachable_asset_count *
    iff(cls_str has_any ("PCI","PHI","HIPAA"), 4,
    iff(cls_str has "PII", 3,
    iff(cls_str has_any ("Financial","Trade Secret"), 2, 1)))
| project identity_id, identity_type, blast_score, reachable_asset_count,
          classifications, data_sources, sample_assets
| order by blast_score desc
| take 25
