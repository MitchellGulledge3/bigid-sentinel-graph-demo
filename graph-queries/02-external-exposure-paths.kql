// External Exposure Paths
// Question: Show every path from an ExternalParty to a regulated asset
// (PII / PHI / PCI / Financial), 1-3 hops, sorted by shortest path first.
//
// Output: external_party, path_length, target_asset, classification, path_assets.
//
// Use case: privacy / DPO review of "what is the shortest way somebody outside
// the org can reach our regulated data?"

let src = BigIDDSPMAssetStoreDemo_CL
| project AssetId, AssetName, Classification, DataSource,
          Owner, LastAccessedBy, ExposedToUsers;
let assetNodes = src
| project nodeId = tostring(AssetId), nodeType = "Asset",
          label = AssetName, classification = tostring(Classification);
let identityNodes = src
| mv-expand exposed = ExposedToUsers to typeof(string)
| extend ids = pack_array(tostring(Owner), tostring(LastAccessedBy), exposed)
| mv-expand id = ids to typeof(string)
| where isnotempty(id)
| extend isExternal = id !contains "@contoso.com" and (id contains "@" or id contains "anonymous" or id contains "link" or id contains "ext-")
| project nodeId = id, nodeType = iff(isExternal, "ExternalParty", "User"),
          label = id, classification = ""
| distinct nodeId, nodeType, label, classification;
let nodes = union assetNodes, identityNodes | distinct nodeId, nodeType, label, classification;
let edges = union
    (src | mv-expand exposed = ExposedToUsers to typeof(string)
         | where isnotempty(exposed)
         | project source = exposed, target = tostring(AssetId), edge = "CAN_REACH"),
    (src | where isnotempty(Owner)
         | project source = tostring(Owner), target = tostring(AssetId), edge = "OWNS"),
    (src | where isnotempty(LastAccessedBy)
         | project source = tostring(LastAccessedBy), target = tostring(AssetId), edge = "ACCESSES");
edges
| make-graph source --> target with nodes on nodeId
| graph-match (ext)-[e*1..3]->(target)
    where ext.nodeType == "ExternalParty"
      and target.nodeType == "Asset"
      and target.classification in ("PII","PHI","PCI","Financial")
    project external_party = ext.label,
            target_asset = target.label,
            classification = target.classification,
            path_length = array_length(e),
            edge_chain = e.edge
| summarize arg_min(path_length, edge_chain) by external_party, target_asset, classification
| order by path_length asc, classification asc
| take 50
